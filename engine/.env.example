# FortyGuard tOS Enterprise API. Never commit the real value.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# The agent's model. Bring your own: the hackathon supplies FortyGuard credits,
# not model credits. Any OpenAI-compatible provider with tool calling works, and
# several have a usable free tier.
#
#   qwen | groq | openrouter | cerebras | deepseek | together | openai | anthropic
#
# Leave both blank and the engine still serves the whole application, running the
# agent's deterministic path and labelling it as such.
THERMCUE_LLM_PROVIDER=
THERMCUE_LLM_API_KEY=

# Optional. Blank means take the provider's default model.
THERMCUE_AGENT_MODEL=
# Optional. Only needed for a provider not in the preset list above.
THERMCUE_LLM_BASE_URL=

# Anthropic uses its own variable because it speaks a different protocol.
ANTHROPIC_API_KEY=

# Set to 1 to prove the cache fallback with networking disabled.
THERMCUE_OFFLINE=0

# Optional path override for the committed independent station validation report.
# The default is research/observed_validation.json from the repository root.
# THERMCUE_OBSERVED_VALIDATION_PATH=/absolute/path/to/observed_validation.json
